# Files that must NOT be served publicly by the Cloudflare Worker.
# [assets].directory is the repo root ("."), so anything not listed here is
# web-accessible. Keep only the actual site + discovery endpoints public;
# exclude build tooling, config, source, tests, and repo docs.

# Build/dev tooling, config & source
worker.js
wrangler.toml
package.json
serve.mjs
verify.mjs
screenshot.mjs
test/
.cfignore
.gitignore
.githooks/

# Repository docs (live on GitHub; not part of the public site)
README.md
AGENTS.md
LinkedIn-BIO-PT-BR.md
portfolio-Thales-Sgarbi-Salata.html
